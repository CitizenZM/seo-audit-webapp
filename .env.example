# --- AI synthesis (executive summary, briefs, keyword ideas) ---
ANTHROPIC_API_KEY=

# --- Real SERP intelligence (#4) ---
# googlethis was tried and removed (broken parser + high-severity audit
# findings — see src/lib/serp.ts). SERP data requires a Serper.dev key:
SERPER_API_KEY=

# --- Email reports + scheduled monitoring (#7, via Resend) ---
RESEND_API_KEY=
# Verified sender (defaults to Resend's shared onboarding@resend.dev for testing):
RESEND_FROM=SEO Audit <onboarding@resend.dev>

# Secret that Vercel Cron must present (Authorization: Bearer <CRON_SECRET>):
CRON_SECRET=

# --- Supabase (persisted history, real async job progress, auth, watchlist) ---
# URL + anon key are public/safe-to-ship. Service role key is a SECRET — get
# it from Supabase Dashboard > Project Settings > API > service_role, and
# never expose it to the browser. Without SUPABASE_SERVICE_ROLE_KEY set,
# these features gracefully no-op: history falls back to localStorage only,
# sign-in/watchlist are unavailable, and audits still run synchronously.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Multi-engine visibility probing (optional; each key adds an engine) ---
PERPLEXITY_API_KEY=
# Agnes AI free OpenAI-compatible gateway (https://apihub.agnes-ai.com/v1):
AGNES_API_KEY=
AGNES_MODEL=agnes-2.0-flash

# --- AI crawler analytics: Vercel Log Drain -> POST /api/crawler-logs ---
# (configure the drain with header  x-crawler-secret: <CRAWLER_LOGS_SECRET>)
CRAWLER_LOGS_SECRET=

# --- Operator gate: comma-separated emails allowed into client workspaces.
# Fails CLOSED — unset means nobody can view client data.
OPERATOR_EMAILS=

# --- Extra GEO probe engines (OpenAI-compatible; see src/lib/probeEngines.ts) ---
# Policy: no paid OpenAI/Perplexity models (filtered out even if listed).
OPENROUTER_API_KEY=
OPENROUTER_PROBE_MODELS=nvidia/nemotron-3-super-120b-a12b:free
MATRIX_API_KEY=
MATRIX_PROBE_MODELS=qwen/qwen3.5-397b-a17b

# --- Implementation engine (Shopify, Tier 1) ---
# Per-store Admin API token from a custom app (scopes: read/write products + files):
# Dev Dashboard app (2026+; legacy custom apps can no longer be created):
# SHOPIFY_CLIENT_ID_<CLIENT_SLUG> + SHOPIFY_CLIENT_SECRET_<CLIENT_SLUG> (client credentials grant, 24h token)
# Legacy token still accepted: SHOPIFY_ADMIN_TOKEN_<CLIENT_SLUG>=shpat_...
SHOPIFY_API_VERSION=2026-04

# --- One-click Shopify connection (OAuth authorization code grant) ---
# App-level Dev Dashboard app credentials (redirect URL allowlisted:
# https://<host>/api/shopify/callback) and a 32-byte base64 key used to
# AES-256-GCM-encrypt stored tokens.
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
SHOPIFY_TOKEN_ENC_KEY=
